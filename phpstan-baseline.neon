parameters:
	ignoreErrors:
		-
			message: '#^Call to an undefined method App\\Models\\User\:\:userAchievements\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: app/Models/User.php

		-
			message: '#^Undefined variable\: \$achievemen$#'
			identifier: variable.undefined
			count: 1
			path: database/seeders/AchievementsSeeder.php
